POSTGRES_DB=crowd_feedback
DATABASE_USERNAME=crowd
DATABASE_PASSWORD=replace-with-a-local-development-password
# At least 32 random bytes; generate a unique value, for example: openssl rand -base64 48
JWT_SECRET=replace-with-at-least-32-random-bytes-before-running
ACCESS_TOKEN_LIFETIME=PT20M
REFRESH_SESSION_INACTIVITY=P90D
# Optional local-only ADMIN bootstrap. Leave both empty to disable.
APP_ADMIN_EMAIL=
APP_ADMIN_PASSWORD=
